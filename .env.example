# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Infrastructure ---
# Matches docker-compose.yml
DATABASE_URL=postgresql://onego:onego@localhost:5432/onego?schema=public
REDIS_URL=redis://localhost:6379

# --- Security ---
# 32-byte base64 key used to encrypt provider credentials at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# 32+ char secret used to sign session tokens. Generate similarly.
JWT_SECRET=

# --- Provider bootstrap (optional, dev convenience only) ---
# Provider credentials are normally added through the UI and stored encrypted.
# These are only read by explicit dev bootstrap scripts, never committed.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GITHUB_MODELS_TOKEN=
# QODER_PERSONAL_ACCESS_TOKEN=
